<%- include('partials/header') %>

<h1>สวัสดี <%= user.username %></h1>
<p class="muted">เข้าสู่ระบบด้วยอีเมล <%= user.email %></p>

<div class="stats">
  <div class="stat">
    <div class="stat-num"><%= stats.active %></div>
    <div class="stat-label">เล่มที่ยืมอยู่</div>
  </div>
  <div class="stat <%= stats.overdue > 0 ? 'stat-danger' : '' %>">
    <div class="stat-num"><%= stats.overdue %></div>
    <div class="stat-label">เกินกำหนดคืน</div>
  </div>
  <div class="stat">
    <div class="stat-num"><%= visitCount %></div>
    <div class="stat-label">ผู้เข้าชม (IP)</div>
  </div>
</div>

<div class="actions">
  <a href="/books" class="btn">ค้นหาหนังสือ</a>
  <a href="/loans" class="btn btn-outline">ดูหนังสือที่ยืม</a>
</div>

<form method="POST" action="/logout">
  <button type="submit" class="btn btn-ghost">ออกจากระบบ</button>
</form>

<%- include('partials/footer') %>
